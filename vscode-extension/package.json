{
  "name": "agentic-qa",
  "displayName": "Agentic-QA",
  "description": "Run the Agentic-QA automation framework directly from VS Code.",
  "version": "0.2.15",
  "publisher": "aravifleet",
  "scripts": {
    "prepare-python-bundle": "node ./scripts/prepare-python-bundle.js",
    "vscode:prepublish": "npm run prepare-python-bundle",
    "package:vsix": "node ./scripts/package-vsix.js"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "keywords": [
    "QA",
    "automation",
    "playwright",
    "testing",
    "agentic"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aravifleet/aiworkshop.git"
  },
  "activationEvents": [
    "onCommand:agenticQA.run",
    "onCommand:agenticQA.teach"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agenticQA.run",
        "title": "Agentic-QA: Run automation"
      },
      {
        "command": "agenticQA.teach",
        "title": "Agentic-QA: Teach from manual exploration"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Agentic QA",
      "properties": {
        "agenticQA.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Optional Python executable used to launch the Agentic QA CLI. Leave empty to use python on Windows or python3 on macOS/Linux."
        }
      }
    }
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2"
  }
}
